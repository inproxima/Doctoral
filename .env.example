# Copy to .env and fill in the key.
OPENAI_API_KEY=sk-proj-replace-me

# Model and reasoning effort for every call the app makes.
OPENAI_MODEL=gpt-5.6-sol
REASONING_EFFORT=high

# How many model calls may be in flight at once.
MAX_CONCURRENT_CALLS=4

# Cap on output tokens per call.
MAX_OUTPUT_TOKENS=16000

PORT=8020

# Hosting only. Bind address (0.0.0.0 on Render), a password that gates the whole
# app behind basic auth, and where examination runs are stored (a persistent disk).
# HOST=0.0.0.0
# APP_PASSWORD=
# RUNS_DIR=/var/data/runs
